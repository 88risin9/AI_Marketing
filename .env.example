# Copy to .env, run chmod 600 .env, then fill locally. Never paste keys in the browser.
# .env is excluded from Git and backups. Environment variables override this file.
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_API_KEY=
AI_TIMEOUT=45

# Buyer research (server-side only). Brave: https://api-dashboard.search.brave.com/
# Tavily: https://app.tavily.com/ — choose provider, then its matching key.
RESEARCH_SEARCH_PROVIDER=brave
RESEARCH_SEARCH_API_KEY=
RESEARCH_READER_ENABLED=true
RESEARCH_HTTP_TIMEOUT=15
# Missing search/model keys do not disable manual URLs, pages, inquiries or quotes.
# Each research task separately limits searches, model calls and pages; fees are not estimated.

# Compatible provider example (check the provider's current model availability):
# AI_PROVIDER=compatible
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=your-supported-model
# AI_API_KEY=your-local-key
# Compatible mode uses POST /chat/completions with response_format=json_object.
# API_BASE_URL is the API root, not the complete endpoint. HTTPS is required remotely.
